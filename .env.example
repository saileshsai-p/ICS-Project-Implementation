# Copy to .env and set the master key. See README section 5b for full details.
# .env is git-ignored. Never commit it.

# REQUIRED. 32-byte key as 64 hex chars. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Losing this key makes every stored file permanently unreadable. Keep a backup.
FILE_ENCRYPTION_MASTER_KEY=replace_me_with_64_hexadecimal_characters

# Optional. Defaults shown.
PORT=3000
# NODE_ENV=development          # "production" adds Secure to the session cookie
# MAX_FILE_SIZE_BYTES=52428800  # 50 MB
# MAX_EXPIRY_DAYS=365
# SESSION_LIFETIME_MS=604800000 # 7 days
# SESSION_COOKIE_NAME=secushare_session
# CLEANUP_INTERVAL_MS=60000
# TEMP_FILE_MAX_AGE_MS=900000   # 15 min

# Testing only. The test suite and benchmark set these to temp dirs themselves
# and refuse to run if they resolve inside the project.
# SECUSHARE_DATA_DIR=
# SECUSHARE_STORAGE_DIR=
# SECUSHARE_ENV_FILE=
